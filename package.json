{
  "name": "pilates-studio-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "umi dev",
    "build": "umi build",
    "typecheck": "tsc --noEmit",
    "smoke-test": "vitest run smoke-tests",
    "smoke-test:watch": "vitest smoke-tests",
    "smoke-test:cov": "vitest run smoke-tests --coverage",
    "release:check": "powershell -ExecutionPolicy Bypass -File scripts/release-readiness-check.ps1",
    "lint": "eslint src config --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src config --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --check package.json .eslintrc.cjs .prettierrc.json",
    "format:write": "prettier --write package.json .eslintrc.cjs .prettierrc.json"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.27.1",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/visitor-keys": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^3.2.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "umi": "^4.4.6",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@babel/runtime": "7.29.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.0",
    "postcss": "8.5.13",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3",
    "send": "0.19.2",
    "tsx": "4.21.0",
    "vite": "8.0.10",
    "@umijs/preset-umi": {
      "path-to-regexp": "1.9.0"
    }
  }
}
