# ============================================
# 愈己CareMe工作室 Backend - Environment Variables
# Copy this file to backend/local-config and fill in real values.
# ============================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=careme-studio-backend
API_PREFIX=api

# Database (MySQL)
# Set to your local or managed MySQL connection URL.
DATABASE_URL=

# JWT Authentication
# IMPORTANT: Replace with strong secrets in production (min 32 chars)
# Generate: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=10

# CORS (comma-separated origins; wildcard is blocked in production)
CORS_ORIGINS=http://localhost:8000

# Logging
# Levels: debug, verbose, log, warn, error
LOG_LEVEL=log

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Image Upload and MinIO Object Storage
# Uploaded images are optimized to IMAGE_MAX_OUTPUT_BYTES before storing.
IMAGE_MAX_OUTPUT_BYTES=512000
IMAGE_UPLOAD_MAX_BYTES=10485760
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pilates-images
MINIO_REGION=us-east-1
MINIO_SET_PUBLIC_READ=true
# Use a public bucket or a CDN/domain mapped to the bucket prefix below.
# Example local value: http://127.0.0.1:9000/pilates-images
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:19000/pilates-images

# WeChat Mini Program (optional, for mini user auth)
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MINIPROGRAM_STATE=trial
WECHAT_TEMPLATE_ID_BOOKING_CONFIRMATION=YWFpfLKKasXqCC8fcFRYbUMD-0IxtpxyIWI4mboleTc
WECHAT_TEMPLATE_ID_BOOKING_CANCELLED=
WECHAT_TEMPLATE_ID_BOOKING_REMINDER=IuIFavZGWZ62G2G2-QqXVWJJqvj_YS5UrJx6XXIK1Xg
WECHAT_TEMPLATE_ID_ATTENDANCE_CHECKED_IN=
WECHAT_TEMPLATE_ID_MEMBERSHIP_EXPIRY=
# Optional field mapping for the exact template fields configured in WeChat.
# Format: field:source,field:source or JSON object. Sources resolve from notification payload/title/content.
WECHAT_TEMPLATE_FIELDS_BOOKING_CONFIRMATION=thing2:courseName,thing5:remark
WECHAT_TEMPLATE_FIELDS_BOOKING_CANCELLED=thing1:courseName,time2:cancelledAt,thing3:bookingCode,thing4:remark
WECHAT_TEMPLATE_FIELDS_BOOKING_REMINDER=thing2:courseName,time3:startsAt
WECHAT_TEMPLATE_FIELDS_ATTENDANCE_CHECKED_IN=thing1:courseName,time2:checkedInAt,thing3:memberName,thing4:remark
WECHAT_TEMPLATE_FIELDS_MEMBERSHIP_EXPIRY=thing1:planName,date2:expiryDate,thing3:memberName,thing4:remark

# WeChat Pay (optional in development, required for real payment closure)
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MOCK=true
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=

# Email (optional, for notification delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Analytics
ANALYTICS_MONTHLY_REVENUE_GOAL_CENTS=5000000

# Notifications
NOTIFICATION_EXPIRY_REMINDER_DAYS=3
NOTIFICATION_BOOKING_REMINDER_MINUTES=60
NOTIFICATION_PROCESSING_BATCH_SIZE=50

# Seed Data (first admin user; SEED_ADMIN_PASSWORD is required before running prisma db seed)
SEED_ADMIN_EMAIL=admin@pilates.com
SEED_ADMIN_PASSWORD=
SEED_MINI_OPEN_ID=dev-openid-pilates
