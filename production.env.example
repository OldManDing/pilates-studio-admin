# Copy this file to .env on the production host.
# Never commit the real .env file.

# MySQL container bootstrap
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password-min-32-chars
MYSQL_PASSWORD=replace-with-strong-app-password-min-32-chars

# Backend runtime
NODE_ENV=production
PORT=3000
API_PREFIX=api
DATABASE_URL=mysql://pilates:replace-with-strong-app-password-min-32-chars@mysql:3306/pilates_studio
JWT_ACCESS_SECRET=replace-with-strong-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=https://admin.example.com,https://api.example.com
LOG_LEVEL=log
ENABLE_SWAGGER=false
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# WeChat Mini Program login and templates
WECHAT_APPID=replace-with-wechat-mini-program-appid
WECHAT_SECRET=replace-with-wechat-mini-program-secret
WECHAT_TEMPLATE_ID_BOOKING_CONFIRMATION=
WECHAT_TEMPLATE_ID_BOOKING_CANCELLED=
WECHAT_TEMPLATE_ID_BOOKING_REMINDER=
WECHAT_TEMPLATE_ID_ATTENDANCE_CHECKED_IN=
WECHAT_TEMPLATE_ID_MEMBERSHIP_EXPIRY=
WECHAT_TEMPLATE_FIELDS_BOOKING_CONFIRMATION=thing1:courseName,time2:startsAt,thing3:studioName,character_string4:bookingCode,thing5:remark
WECHAT_TEMPLATE_FIELDS_BOOKING_CANCELLED=thing1:courseName,time2:cancelledAt,thing3:bookingCode,thing4:remark
WECHAT_TEMPLATE_FIELDS_BOOKING_REMINDER=thing1:courseName,time2:startsAt,thing3:studioName,thing4:coachName,thing5:remark
WECHAT_TEMPLATE_FIELDS_ATTENDANCE_CHECKED_IN=thing1:courseName,time2:checkedInAt,thing3:memberName,thing4:remark
WECHAT_TEMPLATE_FIELDS_MEMBERSHIP_EXPIRY=thing1:planName,date2:expiryDate,thing3:memberName,thing4:remark

# WeChat Pay
# If launch uses offline/manual payment, keep WECHAT_PAY_ENABLED=false and document the operating SOP.
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MOCK=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Analytics and notification jobs
ANALYTICS_MONTHLY_REVENUE_GOAL_CENTS=5000000
NOTIFICATION_EXPIRY_REMINDER_DAYS=3
NOTIFICATION_BOOKING_REMINDER_MINUTES=60
NOTIFICATION_PROCESSING_BATCH_SIZE=50

# Initial seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-temporary-seed-password-rotate-after-login
SEED_MINI_OPEN_ID=
